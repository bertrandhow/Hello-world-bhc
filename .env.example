# Microsoft Graph / Azure AD
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret        # only required for client_credentials flow
GRAPH_AUTH_FLOW=device_code                   # "device_code" | "client_credentials"
MAILBOX_USER_ID=me                            # "me" for device_code; UPN/GUID for client_credentials

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# Dropbox
DROPBOX_APP_KEY=your-app-key
DROPBOX_APP_SECRET=your-app-secret
DROPBOX_REFRESH_TOKEN=your-long-lived-refresh-token   # obtained via: python main.py setup-dropbox

# Archiver behaviour
STATE_FILE_PATH=.archiver_state.json
BATCH_SIZE=20
MAX_EMAILS=0    # 0 = no limit
LOG_LEVEL=INFO
